# ==============================================================================
# MANOFICA — CONFIGURATION SERVEUR APACHE / LITESPEED
# ==============================================================================

RewriteEngine On
RewriteBase /

# 1. Redirection canonique : index.html -> racine /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Redirection des routes secondaires vers les ancres du site
RewriteRule ^(carte|menu)(\.html)?$ /#carte [R=301,NE,L]
RewriteRule ^(ambiance|histoire)(\.html)?$ /#ambiance [R=301,NE,L]
RewriteRule ^(reservation|reserver)(\.html)?$ /#reservation [R=301,NE,L]
RewriteRule ^(contact|acces)(\.html)?$ /#contact [R=301,NE,L]

# 3. Sécurité HTTP renforcée
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. Compression Gzip / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 5. Mise en cache des médias statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
